# /etc/systemd/system/khome-contact.service  (CT 1320 beconnected-web)
[Unit]
Description=Be Connected website contact form -> Telegram
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/var/www/beconnected-web
ExecStart=/usr/bin/node /var/www/beconnected-web/server/contact-server.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
