# /opt/beconnected-solar/solar.env on CT 1330 — root:root, chmod 600. NEVER commit the real file.
# deploy-solar.sh creates it on first deploy from SOLAR_SERVER_KEY in khome-smart-web/.env.local.
SOLAR_SERVER_KEY=
PORT=8790
HOST=0.0.0.0
# only HAProxy (and localhost) may call /insights; /health stays open on the LAN
TRUSTED_PROXIES=10.10.13.13,127.0.0.1
# Google calls per Bangkok day, all users combined (budget guard)
SOLAR_DAILY_LIMIT=300
# /insights calls per visitor IP per hour
SOLAR_IP_HOURLY=20
